#!/usr/bin/env php
<?php
/**
 * pikkumies: install | update | detect | doctor | generate | cron-tick | run [args...] | <free text prompt>
 *
 * Any number of instances may run at once in one account: HERMES_HOME is shared on purpose
 * (ADR-0003) and Hermes' own session database and active-session registry are built for
 * concurrent writers; the files pikkumies itself regenerates on every run (skills, tools/INDEX.md,
 * config.yaml, .env, SOUL.md) are written through a lock or an atomic rename, so two instances
 * starting together never see a half-written file (ADR-0022).
 */
// Everything we write (config, .env with the key, profile) is private to the user from
// creation; chmod-after-write would leave a window where a secret is world-readable.
umask(0077);

foreach (glob(dirname(__DIR__) . '/lib/*.php') as $lib) {
    require_once $lib;
}

function out($line)
{
    fwrite(STDOUT, $line . "\n");
}

function profile($refresh = false)
{
    $profile = Detect::cached($refresh);
    @mkdir(Config::localDir(), 0700, true);
    @chmod(Config::localDir(), 0700);
    // Nothing reads this file back (it is informational, for `detect`/a human looking at local/);
    // still written through a temp file + rename, best-effort, so a concurrent run never sees it
    // half-written (a failed write here must never stop `run` from starting Hermes).
    $path = Config::localDir() . '/profile.json';
    $json = json_encode($profile, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . "\n";
    $tmp = $path . '.tmp-' . getmypid();
    if (@file_put_contents($tmp, $json) !== strlen($json) || !@rename($tmp, $path)) {
        @unlink($tmp);
    }
    return $profile;
}

/**
 * Skills and tools/INDEX.md from the tool units, then the Hermes config (ADR-0015). Throws when a
 * file cannot be written, so `run` never starts Hermes on a half-written config.
 */
function generate(array $profile)
{
    $config = Config::load();
    $result = Generate::run(Generate::disabledCategories($config));
    if ($result['error'] !== '') {
        throw new Exception($result['error']);
    }
    foreach ($result['problems'] as $unit => $problems) {
        fwrite(STDERR, "tool unit $unit skipped: " . implode('; ', $problems) . "\n");
    }
    HermesConfig::write($config, $profile);
    return $result;
}

/**
 * Provider and app documentation for this host, filled in the background (ADR-0027): a few hundred
 * pages at one per second or slower must not hold up install or update. One fill at a time (flock).
 */
function startDocsFill()
{
    $docsLog = Config::localDir() . '/docs-fill.log';
    exec('nohup flock -n ' . escapeshellarg(Config::localDir() . '/docs-fill.lock') . ' ' . escapeshellarg(PHP_BINARY) . ' '
        . escapeshellarg(__FILE__) . ' docs-fill > ' . escapeshellarg($docsLog) . ' 2>&1 &');
    return 'filling in the background (log: local/docs-fill.log)';
}

function hermesBin()
{
    return Config::root() . '/include/hermes/bin/hermes';
}

list($cmd, $passArgs) = Launch::route($argv);

switch ($cmd) {
    case 'install':
        $home = getenv('HOME');
        $link = $home . '/pikkumies';
        if (!file_exists($link)) {
            @symlink(Config::root(), $link);
        }
        Config::writeDefaultsIfMissing();
        $profile = profile();
        try {
            $generated = generate($profile);
        } catch (Exception $x) {
            out('install stopped: ' . $x->getMessage());
            exit(1);
        }
        out('pikkumies installed at ' . Config::root());
        out('  root: ' . ($profile['root']['available'] ? 'available via ' . $profile['root']['via'] : 'not available'));
        out('  pmss: ' . ($profile['pmss'] ? 'yes' : 'no') . '; apps: ' . (implode(', ', $profile['apps']) ?: 'none'));
        out('  host: ' . $profile['family'] . '; tools: ' . $generated['skills'] . ' skills');
        out('  hermes: ' . HermesInstall::ensure(Config::load()));
        out('  auto-update: ' . Update::schedule(Config::load(), $profile['uid']));
        out('  cron-tick: ' . Update::scheduleCronTick(Config::load(), !empty($profile['root']['available'])));
        out('  docs: ' . startDocsFill());
        try {
            out('  path: ' . PathInstall::install($home, (string) getenv('PATH'), $link . '/bin/pikkumies'));
        } catch (Exception $x) {
            out('  path: not set up: ' . $x->getMessage());
        }
        out('Next: set your provider in local/config.php or ~/.pikkumiesKey, then `pikkumies doctor`.');
        out('Then open a new shell (or `hash -r`) and type `pikkumies`.');
        break;

    case 'update':
        list($ok, $msg) = Update::run();
        out($msg);
        if (!$ok) {
            exit(1);
        }
        // This process still has the old code loaded; the rest runs the new code in a fresh one.
        passthru(escapeshellarg(PHP_BINARY) . ' ' . escapeshellarg(__FILE__) . ' post-update', $postCode);
        exit($postCode === 0 ? 0 : 1);

    case 'post-update': // internal: the second half of `update`, run by the updated code
        $profile = profile();
        try {
            $r = generate($profile);
        } catch (Exception $x) {
            out('generate failed: ' . $x->getMessage());
            exit(1);
        }
        out('generated ' . $r['skills'] . ' skills and tools/INDEX.md');
        $config = Config::load();
        out('auto-update: ' . Update::schedule($config, function_exists('posix_geteuid') ? posix_geteuid() : getmyuid()));
        out('cron-tick: ' . Update::scheduleCronTick($config, !empty($profile['root']['available'])));
        foreach (HermesInstall::cleanup($config) as $old) {
            out('removed old Hermes build ' . $old);
        }
        out('hermes: ' . HermesInstall::ensure($config));
        out('docs: ' . startDocsFill());
        break;

    case 'docs-fill': // internal: the daily background fill of documentation sources
        // Servers updated together must not fetch the same sites together: start at a random point within the hour.
        sleep(DocSources::fillJitter());
        foreach (DocSources::fill() as $row) {
            out(gmdate('c') . ' ' . $row[0] . ': ' . ($row[1] ? 'ok ' : 'failed ') . $row[2]);
        }
        break;

    case 'detect':
        $refresh = in_array('--refresh', $passArgs, true);
        $human = in_array('--human', $passArgs, true);
        $p = profile($refresh);
        if ($human) {
            echo CliHuman::render([CliHuman::flatten($p)]);
            echo CliHuman::statusLine(['ok' => true, 'count' => 1]), "\n";
        } else {
            out(json_encode($p, JSON_UNESCAPED_SLASHES)); // jsonl default: one compact record (ADR-0016)
        }
        break;

    case 'doctor':
        $config = Config::load();
        $prov = Provider::resolve($config);
        list($ok, $http) = Provider::check($prov);
        out('endpoint: ' . ($prov['endpoint'] ?: '(not set)'));
        out('key:      ' . Provider::mask($prov['key']));
        out('provider: ' . ($ok ? 'reachable' : 'not reachable (HTTP ' . $http . ')'));
        out('model:    ' . (Provider::model($prov) ?: '(none: set provider.model in local/config.php)'));
        $cur = HermesInstall::currentTag();
        $pin = $config['hermes']['version'];
        list(, $py) = HermesInstall::python();
        out('hermes:   ' . ($cur === '' ? 'not installed' : 'installed ' . $cur) . '; pinned ' . $pin . (is_dir(HermesInstall::buildDir($pin)) && !HermesInstall::isComplete($pin) ? ' (building or failed, see local/install.log)' : '') . '; ' . $py);
        $units = Units::all();
        $bad = array_filter($units, function ($u) {
            return $u['errors'];
        });
        out('tools:    ' . count($units) . ' units' . ($bad ? ', ' . count($bad) . ' with problems (run `pikkumies generate`)' : '') . '; off: ' . (implode(', ', Generate::disabledCategories($config)) ?: 'none'));
        if (!empty($config['packs']['disabled'])) {
            out('note:     packs.disabled in local/config.php is no longer read; use tools.disabled with category names (ADR-0015)');
        }
        // One line per Hermes feature pikkumies turns on at generate time (ADR-0024), read back
        // from the actual generated config.yaml rather than assumed, so a write failure shows here too.
        $yaml = (string) @file_get_contents(HermesConfig::home() . '/config.yaml');
        if ($yaml === '') {
            out('features: not generated yet (run `pikkumies generate`)');
        } else {
            $has = function ($needle) use ($yaml) {
                return strpos($yaml, $needle) !== false;
            };
            out('features:');
            out('  guard scan (agent-created skills): ' . ($has("  guard_agent_created: true\n") ? 'on' : 'off'));
            out('  checkpoints (/rollback):           ' . ($has("checkpoints:\n  enabled: true\n") ? 'on' : 'off'));
            out('  security-guidance plugin:          ' . ($has('"security-guidance"') ? 'on' : 'off'));
            out('  background review (self-improve):  ' . ($has("background_review:\n    enabled: true\n") ? 'on' : 'off'));
            out('  curator (skill housekeeping):      ' . ($has("curator:\n  enabled: true\n") ? 'on' : 'off'));
            out('  external logins:                   ' . ($has("adopt_external_logins: false\n") ? 'own only' : 'borrowed (Hermes default)'));
        }
        // Documentation sources that apply to this host (ADR-0027): downloaded pages, cache size and any last error.
        $docNames = [];
        $docPages = 0;
        $docErrors = [];
        foreach (DocSources::active() as $name => $src) { // active() never returns link sources
            $m = DocSources::meta($name);
            $docNames[] = $name;
            $docPages += isset($m['count']) ? (int) $m['count'] : 0;
            if (!empty($m['error'])) {
                $docErrors[] = $name;
            }
        }
        out('docs:     ' . count($docNames) . ' sources for this host, ' . $docPages . ' pages downloaded, '
            . round(DocSite::dirBytes(DocSources::cacheRoot()) / 1048576, 1) . ' MB in local/docs-cache'
            . ($docErrors ? '; last fetch failed: ' . implode(', ', $docErrors) . ' (see `pikkumies.php sources`)' : ''));
        // The ticker mode mirrors Update::scheduleCronTick's own decision (ADR-0025), without
        // writing anything: doctor only reads the crontab to report whether the line is actually there.
        $tickOff = !empty($config['cron']['disabled']);
        $tickProfile = Detect::cached();
        if ($tickOff) {
            $tickMode = 'disabled (cron.disabled)';
        } elseif (CronTick::refuses(!empty($tickProfile['root']['available']))) {
            $tickMode = 'refused: no setpriv on a root host';
        } else {
            list(, $crontabOut) = Update::exec([Update::$crontab, '-l']);
            $tickMode = strpos((string) $crontabOut, Update::CRON_TICK_TAG) !== false
                ? 'installed (crontab, every minute)' : 'not installed yet (run `pikkumies install` or `update`)';
        }
        out('cron ticker: ' . $tickMode);
        break;

    case 'generate':
        try {
            $r = generate(profile());
        } catch (Exception $x) {
            out('generate failed: ' . $x->getMessage());
            exit(1);
        }
        out('generated ' . $r['skills'] . ' skills (' . $r['written'] . ' written, ' . $r['removed'] . ' removed) and tools/INDEX.md');
        break;

    case 'run':
        if (isset($passArgs[0]) && $passArgs[0] === 'update') {
            out('Hermes is pinned by Pikkumies (ADR-0009). Run `pikkumies update` instead.');
            exit(1);
        }
        if (!is_file(hermesBin())) {
            out('Hermes is not installed yet; see local/install.log');
            exit(1);
        }
        // Regenerate first, so a key or config set after install reaches Hermes. Never start Hermes
        // on a config that could not be written: it would run without the safety hooks. Safe to run
        // from any number of instances at once: Generate::run takes a lock, every file it and
        // HermesConfig::write touch is written through a temp file + rename (ADR-0022).
        try {
            generate(profile());
        } catch (Exception $x) {
            out('not starting: ' . $x->getMessage());
            exit(1);
        }
        putenv('HERMES_HOME=' . HermesConfig::home());
        $args = array_map('escapeshellarg', $passArgs);
        passthru(escapeshellarg(hermesBin()) . ' ' . implode(' ', $args), $code);
        exit($code);

    case 'cron-tick': // internal: the crontab line Update::scheduleCronTick installs, once a minute
        $lockPath = Config::localDir() . '/cron.lock';
        @mkdir(Config::localDir(), 0700, true);
        $lock = @fopen($lockPath, 'c');
        if (!$lock || !flock($lock, LOCK_EX | LOCK_NB)) {
            exit(0); // a previous tick is still running; silent, there is another one in a minute
        }
        if (!is_file(hermesBin())) {
            exit(0); // Hermes not installed yet; `run`/`doctor` already say so, no need to repeat every minute
        }
        $tickProfile = profile();
        $tickArgv = CronTick::argv(hermesBin(), !empty($tickProfile['root']['available']));
        if (!$tickArgv) {
            CronTick::logRefusalOnce(Config::localDir() . '/update.log');
            exit(0);
        }
        putenv('HERMES_HOME=' . HermesConfig::home());
        $tickOut = [];
        exec(implode(' ', array_map('escapeshellarg', $tickArgv)) . ' 2>&1', $tickOut, $tickCode);
        CronTick::logIfChanged(Config::localDir() . '/update.log', Config::localDir() . '/cron-tick.state', $tickCode, implode("\n", $tickOut));
        exit($tickCode);

    case 'help':
    default:
        out('usage: pikkumies [install | update | detect | doctor | generate]');
        out('       pikkumies [run [hermes args...]]           plain interactive session');
        out('       pikkumies <free text>                      start a session with that as the first prompt');
        out('       pikkumies -- <free text>                   force a prompt even if it starts with a subcommand name');
}
