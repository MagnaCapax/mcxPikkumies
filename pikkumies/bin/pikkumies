#!/usr/bin/env php
<?php
/**
 * pikkumies: install [flags] | update | detect | doctor | generate | cron-tick | tmux [N] | configure | run [args...]
 *            | [-m <model>] [--reasoning <level>] <free text prompt>
 *
 * Any number of instances may run at once in one account: HERMES_HOME is shared on purpose
 * (ADR-0003) and Hermes' own session database and active-session registry are built for
 * concurrent writers; the files pikkumies itself regenerates on every run (skills, tools/INDEX.md,
 * the managed Hermes config and .env, SOUL.md) are written through a lock or an atomic rename, so two instances
 * starting together never see a half-written file (ADR-0022); the user's Hermes config.yaml is seeded once and
 * then only edited, backed up and logged, under a lock (ADR-0062).
 */
// Everything we write (config, .env with the key, profile) is private to the user from
// creation; chmod-after-write would leave a window where a secret is world-readable.
umask(0077);

foreach (glob(dirname(__DIR__) . '/lib/*.php') as $lib) {
    require_once $lib;
}

function out($line)
{
    fwrite(STDOUT, $line . "\n");
}

function profile($refresh = false)
{
    $profile = Detect::cached($refresh);
    @mkdir(Config::localDir(), 0700, true);
    @chmod(Config::localDir(), 0700);
    // Nothing reads this file back (it is informational, for `detect`/a human looking at local/);
    // still written through a temp file + rename, best-effort, so a concurrent run never sees it
    // half-written (a failed write here must never stop `run` from starting Hermes).
    $path = Config::localDir() . '/profile.json';
    $json = json_encode($profile, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . "\n";
    $tmp = $path . '.tmp-' . getmypid();
    if (@file_put_contents($tmp, $json) !== strlen($json) || !@rename($tmp, $path)) {
        @unlink($tmp);
    }
    return $profile;
}

/**
 * Skills and tools/INDEX.md from the tool units, then the Hermes config (ADR-0015). Throws when a
 * file cannot be written, so `run` never starts Hermes on a half-written config.
 */
function generate(array $profile)
{
    $config = Config::load();
    $result = Generate::run(Generate::disabledCategories($config), null, null, null, (array) $config['skills']['disabled']);
    if ($result['error'] !== '') {
        throw new Exception($result['error']);
    }
    foreach ($result['problems'] as $unit => $problems) {
        fwrite(STDERR, "unit $unit skipped: " . implode('; ', $problems) . "\n");
    }
    // What changed in the user's own hooks is shown here, at every start, before they run (ADR-0054).
    if ($result['localNotice'] !== '') {
        fwrite(STDERR, 'local hooks: ' . $result['localNotice'] . ' (' . Config::shown(Config::localDir() . '/hooks') . "; pikkumies doctor lists them)\n");
    }
    HermesConfig::write($config, $profile);
    return $result;
}

/**
 * Provider and app documentation for this host, filled in the background (ADR-0027): a few hundred
 * pages at one per second or slower must not hold up install or update. One fill at a time (flock).
 */
function startDocsFill()
{
    $docsLog = Config::localDir() . '/docs-fill.log';
    exec('nohup flock -n ' . escapeshellarg(Config::localDir() . '/docs-fill.lock') . ' ' . escapeshellarg(PHP_BINARY) . ' '
        . escapeshellarg(__FILE__) . ' docs-fill > ' . escapeshellarg($docsLog) . ' 2>&1 &');
    return 'filling in the background (log: ' . Config::shown(Config::localDir() . '/docs-fill.log') . ')';
}

/** The hermes command of a complete install in pikkumies/hermes, '' when there is none (ADR-0033). */
function hermesBin()
{
    return HermesInstall::bin();
}

function promptRead()
{
    return fgets(STDIN);
}

function promptWrite($text)
{
    fwrite(STDOUT, $text);
}

list($cmd, $passArgs) = Launch::route($argv);
if ($cmd === 'error') { // a launcher flag without its value (ADR-0052): nothing is started
    out('Not starting: ' . $passArgs[0]);
    exit(2);
}

switch ($cmd) {
    case 'install':
        // Flags answer the first-start questions, so an install from a script asks nothing (ADR-0032).
        list($installSettings, $installTerms, $flagErrors) = Launch::installFlags($passArgs);
        if ($flagErrors) {
            out('install stopped, nothing changed: ' . implode('; ', $flagErrors));
            exit(2);
        }
        // A fresh clone is main's newest commit. On the release channel it first moves to the newest release
        // and the install runs again from that code. Only before local/ exists: install.sh runs `update` and
        // then `install` on an existing checkout, and that is never moved (ADR-0057).
        $channel = isset($installSettings['update.channel']) ? $installSettings['update.channel'] : Config::load()['update']['channel'];
        list($moved, $moveMsg) = UpdateChannel::firstInstallMove($channel, Config::localDir());
        if ($moveMsg !== '') {
            out('release: ' . $moveMsg);
        }
        if ($moved) {
            passthru(escapeshellarg(PHP_BINARY) . ' ' . escapeshellarg(__FILE__) . ' install ' . implode(' ', array_map('escapeshellarg', $passArgs)), $code);
            exit($code);
        }
        $home = getenv('HOME');
        $link = $home . '/pikkumies';
        if (!file_exists($link)) {
            @symlink(Config::root(), $link);
        }
        Config::writeDefaultsIfMissing();
        try {
            foreach ($installSettings as $key => $value) {
                Config::set($key, $value);
            }
            if ($installTerms) {
                Config::acceptTerms();
            }
        } catch (Exception $x) {
            out('install stopped: ' . $x->getMessage());
            exit(1);
        }
        $profile = profile();
        try {
            $generated = generate($profile);
        } catch (Exception $x) {
            out('install stopped: ' . $x->getMessage());
            exit(1);
        }
        out('pikkumies installed at ' . Config::root());
        out('  root: ' . ($profile['root']['available'] ? 'available via ' . $profile['root']['via'] : 'not available'));
        out('  pmss: ' . ($profile['pmss'] ? 'yes' : 'no') . '; apps: ' . (implode(', ', $profile['apps']) ?: 'none'));
        out('  host: ' . $profile['family'] . '; tools: ' . $generated['skills'] . ' skills');
        out('  hermes: ' . HermesInstall::ensure(false, !empty($profile['root']['available']), !empty(Config::load()['hermes']['lazyInstalls'])));
        out('  version: ' . UpdateChannel::describe(Config::load()['update']['channel']));
        out('  auto-update: ' . Update::schedule(Config::load(), $profile['uid']));
        out('  cron-tick: ' . Update::scheduleCronTick(Config::load(), !empty($profile['root']['available'])));
        out('  docs: ' . startDocsFill());
        try {
            out('  path: ' . PathInstall::install($home, (string) getenv('PATH'), $link . '/bin/pikkumies'));
        } catch (Exception $x) {
            out('  path: not set up: ' . $x->getMessage());
        }
        out('Next: a platform key in ~/.virsilipasKey is used as it is; for your own provider put endpoint= and key= in ~/.pikkumiesKey (' . Config::shown(Config::localDir() . '/config.php') . ' can set the endpoint and model, never the key). Then `pikkumies doctor`.');
        out('Then open a new shell (or `hash -r`) and type `pikkumies`.');
        break;

    case 'update':
        list($ok, $msg) = Update::run(Config::load()['update']['channel'], $used);
        out('channel: ' . $used);
        out($msg);
        if (!$ok) {
            exit(1);
        }
        // This process still has the old code loaded; the rest runs the new code in a fresh one.
        passthru(escapeshellarg(PHP_BINARY) . ' ' . escapeshellarg(__FILE__) . ' post-update', $postCode);
        exit($postCode === 0 ? 0 : 1);

    case 'post-update': // internal: the second half of `update`, run by the updated code
        $profile = profile();
        try {
            $r = generate($profile);
        } catch (Exception $x) {
            out('generate failed: ' . $x->getMessage());
            exit(1);
        }
        out('generated ' . $r['skills'] . ' skills and tools/INDEX.md');
        $config = Config::load();
        out('auto-update: ' . Update::schedule($config, function_exists('posix_geteuid') ? posix_geteuid() : getmyuid()));
        out('cron-tick: ' . Update::scheduleCronTick($config, !empty($profile['root']['available'])));
        // Hermes updates on its own path (`pikkumies run update`, ADR-0033): this only builds it where none exists.
        out('hermes: ' . HermesInstall::ensure(true, !empty($profile['root']['available']), !empty($config['hermes']['lazyInstalls'])));
        out('docs: ' . startDocsFill());
        break;

    case 'docs-fill': // internal: the daily background fill of documentation sources
        // Servers updated together must not fetch the same sites together: start at a random point within the hour.
        sleep(DocSources::fillJitter());
        foreach (DocSources::fill() as $row) {
            out(gmdate('c') . ' ' . $row[0] . ': ' . ($row[1] ? 'ok ' : 'failed ') . $row[2]);
        }
        break;

    case 'detect':
        $refresh = in_array('--refresh', $passArgs, true);
        $human = in_array('--human', $passArgs, true);
        $p = profile($refresh);
        if ($human) {
            echo CliHuman::render([CliHuman::flatten($p)]);
            echo CliHuman::statusLine(['ok' => true, 'count' => 1]), "\n";
        } else {
            out(json_encode($p, JSON_UNESCAPED_SLASHES)); // jsonl default: one compact record (ADR-0016)
        }
        break;

    case 'doctor':
        $config = Config::load();
        $prov = Provider::resolve($config);
        list($ok, $http) = Provider::check($prov);
        if (Config::overlayPath() !== '') {
            out('overlay:  ' . Config::overlayPath() . ' (PIKKUMIES_CONFIG, merged over ' . Config::shown(Config::localDir() . '/config.php') . ')');
        } elseif ((string) getenv('PIKKUMIES_CONFIG') !== '') {
            out('overlay:  ' . getenv('PIKKUMIES_CONFIG') . ' NOT USED: missing, unreadable, not yours, or writable by others');
        }
        out('endpoint: ' .($prov['endpoint'] ? preg_replace('#^([a-z][a-z0-9+.-]*://)[^/@]*@#i', '$1', $prov['endpoint']) : '(not set)')); // never a user:password@ part
        $keyFrom = getenv('PIKKUMIES_KEY') ? 'PIKKUMIES_KEY' : Provider::keyFile($config['provider'])['path'];
        out('key:      ' . Provider::mask($prov['key']) . ($prov['key'] !== '' && $keyFrom !== '' ? ' (from ' . $keyFrom . ')' : ''));
        out('provider: ' . ($ok ? 'reachable' : 'not reachable (HTTP ' . $http . ')'));
        $credits = $ok ? Provider::balance($prov) : null;
        if ($credits !== null) {
            out('credits:  ' . number_format($credits, 0, '.', ' ') . ' left on this key');
        }
        out('model:    ' . (Provider::model($prov) ?: '(none: set provider.model in ' . Config::shown(Config::localDir() . '/config.php') . ')'));
        out('pikkumies: ' . UpdateChannel::describe($config['update']['channel'])); // read from the checkout, never fetched (ADR-0057)
        if (HermesInstall::isComplete()) {
            $pyPin = HermesInstall::pythonPin(HermesInstall::lockData());
            $py = 'python ' . ($pyPin !== '' ? $pyPin : '?') . ' managed by Hermes (pm/lock.json)';
            // Read from the checkout itself, never fetched (ADR-0033).
            $hs = HermesInstall::status();
            out('hermes:   ' . $hs['rev'] . ' (' . $hs['sha'] . '), ' . ($hs['clean'] ? 'vanilla' : 'local changes in pikkumies/hermes')
                . ', origin ' . ($hs['official'] ? 'official' : 'NOT the official repository: ' . $hs['origin'] . ' (`pikkumies run update` refuses it)') . '; ' . $py);
            $missingKeys = HermesInstall::missingConfigKeys();
            out('hermes config keys: ' . ($missingKeys ? 'missing: ' . implode(', ', $missingKeys) . ' (Pikkumies will not start this Hermes)' : 'ok'));
            $leaks = HermesInstall::pathLaunchers((string) getenv('HOME'));
            out('hermes on PATH: ' . ($leaks ? implode(', ', $leaks) . ' run this Hermes without the Pikkumies config; remove them' : 'no launchers in ~/.local/bin (cli.expose_on_path: false)'));
        } else {
            out('hermes:   not installed' . (HermesInstall::building() ? ' (building, see ' . Config::shown(HermesInstall::localDir() . '/install.log') . ')' : (file_exists(HermesInstall::treeDir()) ? ' (incomplete build, see ' . Config::shown(HermesInstall::localDir() . '/install.log') . '; `pikkumies install` builds again)' : '')));
        }
        $units = Units::all();
        $bad = array_filter($units, function ($u) {
            return $u['errors'];
        });
        out('tools:    ' . count($units) . ' units' . ($bad ? ', ' . count($bad) . ' with problems (run `pikkumies generate`)' : '') . '; off: ' . (implode(', ', Generate::disabledCategories($config)) ?: 'none'));
        // Hook units, and the user's local ones with why any is skipped (ADR-0054).
        $localHooks = LocalHooks::scan();
        out('hooks:    ' . count(HookUnits::all()) . ' units; local (' . Config::shown(Config::localDir() . '/hooks') . '): '
            . ($localHooks['off'] !== '' ? 'off, ' . $localHooks['off'] : count($localHooks['units']) . ' running'
            . ($localHooks['pending'] ? ', waiting for the next start: ' . implode(', ', array_keys($localHooks['pending'])) : '')
            . implode('', array_map(function ($id, $why) {
                return "; skipped $id: $why";
            }, array_keys($localHooks['problems']), $localHooks['problems']))));
        $localNotice = trim((string) @file_get_contents(Config::localDir() . '/' . LocalHooks::NOTICE));
        if ($localNotice !== '') {
            out('note:     ' . $localNotice . ' (at the last start)');
        }
        if (!empty($config['packs']['disabled'])) {
            out('note:     packs.disabled in ' . Config::shown(Config::localDir() . '/config.php') . ' is no longer read; use tools.disabled with category names (ADR-0015)');
        }
        // One line per Hermes feature pikkumies turns on at generate time (ADR-0024), read back
        // from the actual generated config.yaml rather than assumed, so a write failure shows here too.
        // The pins from the managed file, the feature defaults from the user's own (ADR-0062).
        $yaml = (string) @file_get_contents(HermesConfig::home() . '/config.yaml') . (string) @file_get_contents(HermesConfig::managedDir() . '/config.yaml');
        out(HermesConfigBackup::doctorLine(Config::localDir()));
        if ($yaml === '') {
            out('features: not generated yet (run `pikkumies generate`)');
        } else {
            $has = function ($needle) use ($yaml) {
                return strpos($yaml, $needle) !== false;
            };
            out('features:');
            out('  guard scan (agent-created skills): ' . ($has("  guard_agent_created: true\n") ? 'on' : 'off'));
            out('  checkpoints (/rollback):           ' . ($has("checkpoints:\n  enabled: true\n") ? 'on' : 'off'));
            out('  security-guidance plugin:          ' . ($has('"security-guidance"') ? 'on' : 'off'));
            out('  background review (self-improve):  ' . ($has("background_review:\n    enabled: true\n") ? 'on' : 'off'));
            out('  curator (skill housekeeping):      ' . ($has("curator:\n  enabled: true\n") ? 'on' : 'off'));
            out('  external logins:                   ' . ($has("adopt_external_logins: false\n") ? 'own only' : 'borrowed (Hermes default)'));
        }
        // Documentation sources that apply to this host (ADR-0027): downloaded pages, cache size and any last error.
        $docNames = [];
        $docPages = 0;
        $docErrors = [];
        foreach (DocSources::active() as $name => $src) { // active() never returns link sources
            $m = DocSources::meta($name);
            $docNames[] = $name;
            $docPages += isset($m['count']) ? (int) $m['count'] : 0;
            if (!empty($m['error'])) {
                $docErrors[] = $name;
            }
        }
        out('docs:     ' . count($docNames) . ' sources for this host, ' . $docPages . ' pages downloaded, '
            . round(DocSite::dirBytes(DocSources::cacheRoot()) / 1048576, 1) . ' MB in ' . Config::shown(DocSources::cacheRoot())
            . ($docErrors ? '; last fetch failed: ' . implode(', ', $docErrors) . ' (see `pikkumies.php sources`)' : ''));
        require_once dirname(__DIR__) . '/tools/memory/pikkumies/MemoryStats.php';
        out(MemoryStats::doctorLine()); // lessons on disk, and the last 30 days of searches when perfLogging kept them (ADR-0041)
        // The ticker mode mirrors Update::scheduleCronTick's own decision (ADR-0025), without
        // writing anything: doctor only reads the crontab to report whether the line is actually there.
        $tickOff = !empty($config['cron']['disabled']);
        $tickProfile = Detect::cached();
        if ($tickOff) {
            $tickMode = 'disabled (cron.disabled)';
        } elseif (CronTick::refuses(!empty($tickProfile['root']['available']))) {
            $tickMode = 'refused: no setpriv on a root host';
        } else {
            list(, $crontabOut) = Update::exec([Update::$crontab, '-l']);
            $tickMode = strpos((string) $crontabOut, Update::CRON_TICK_TAG) !== false
                ? 'installed (crontab, every minute)' : 'not installed yet (run `pikkumies install` or `update`)';
        }
        out('cron ticker: ' . $tickMode);
        break;

    case 'generate':
        try {
            $r = generate(profile());
        } catch (Exception $x) {
            out('generate failed: ' . $x->getMessage());
            exit(1);
        }
        out('generated ' . $r['skills'] . ' skills (' . $r['written'] . ' written, ' . $r['removed'] . ' removed) and tools/INDEX.md');
        break;

    case 'configure': // the settings review; on a terminal, a session with the configure skill (ADR-0052)
        if ($passArgs === ['undo']) { // the person's own undo of the last settings change, no session; asked only for a change in the asked tier (ADR-0059 amendment 2026-10-19)
            require_once dirname(__DIR__) . '/tools/system/pikkumies-configure/ConfigureUndo.php';
            exit(ConfigureUndo::run(Launch::isTty(STDIN) && Launch::isTty(STDOUT), 'promptRead', 'promptWrite'));
        }
        if (!Launch::isTty(STDIN) || !Launch::isTty(STDOUT)) {
            // Nobody to answer: a one-shot session would spend credits (and halt-guard resumes) on a fixed review.
            passthru(escapeshellarg(PHP_BINARY) . ' ' . escapeshellarg(dirname(__DIR__) . '/tools/system/pikkumies-configure/pikkumies-configure.php') . ' review --human', $code);
            exit($code);
        }
        $passArgs = Launch::CONFIGURE_ARGS;
        // falls through: the same checks and first-start questions as any session
    case 'run':
        // Started from inside an agent: no flag that turns approvals, hooks or rules off; the user's own shell is untouched (ADR-0020).
        if (($nested = NestedAgent::refusal($passArgs)) !== '') {
            out($nested);
            exit(2);
        }
        if (hermesBin() === '') {
            // A preinstalled account (PMSS) has no runtime until the daily update or this first run builds it: start the build, or
            // find it running, and wait for it here with a progress line, then go on (ADR-0033 addenda 2026-10-17 and 2026-10-19).
            $notReady = HermesWait::run(HermesInstall::ensure(false, !empty(profile()['root']['available']), !empty(Config::load()['hermes']['lazyInstalls'])),
                function () {
                    return hermesBin() !== '';
                }, ['HermesInstall', 'building'], 'promptWrite', HermesInstall::localDir() . '/install.log', Launch::isTty(STDOUT));
            if ($notReady !== '') {
                out('Not starting: the agent runtime could not be set up: ' . $notReady);
                exit(1);
            }
        }
        // A moved account arrives without its crontab and nothing else restores the two lines (Update::ensureScheduled).
        if (Launch::isSession($passArgs)) {
            foreach (Update::ensureScheduled(Config::load(), function_exists('posix_geteuid') ? posix_geteuid() : getmyuid(), !empty(profile()['root']['available'])) as $msg) {
                out('restored in your crontab: ' . $msg);
            }
        }
        // A session without a model key would only fail on its first request: say where the key comes from instead.
        if (Launch::isSession($passArgs) && ($noKey = Launch::missingKeyMessage(Provider::resolve(Config::load()))) !== '') {
            out($noKey);
            exit(1);
        }
        // Hermes' own updater (ADR-0033): alone on the tree, never as more than the account, official origin only.
        $isUpdate = isset($passArgs[0]) && $passArgs[0] === 'update';
        if ($isUpdate) {
            $origin = HermesInstall::origin();
            if (!HermesInstall::originOfficial($origin)) {
                out('Not updating: pikkumies/hermes fetches from ' . ($origin ?: '(no origin)') . ', not the official Hermes repository.');
                exit(1);
            }
            if (!array_intersect(['--yes', '-y'], $passArgs)) {
                // No questions (ADR-0073): Hermes' --yes takes the config migration and the stash restore, and skips the
                // fork-upstream question and API-key entry (hermes_cli/subcommands/update.py).
                array_splice($passArgs, 1, 0, ['--yes']);
            }
            $updateArgv = CronTick::wrap(array_merge([hermesBin()], $passArgs), !empty(profile()['root']['available']));
            if (!$updateArgv) {
                out('Not updating: root is available here and setpriv is missing; the Hermes updater may call sudo, so it runs only under setpriv --no-new-privs (ADR-0025, ADR-0033).');
                exit(1);
            }
        }
        // A dashboard: never without a login (ADR-0074); its web page built first, alone on the tree (ADR-0033 addendum 2026-10-19).
        $dash = HermesDashboardGate::refusal($passArgs, hermesBin());
        if ($dash === '' && HermesWebUi::needed($passArgs)) {
            $dash = HermesWebUi::build(hermesBin(), !empty(profile()['root']['available']), 'out');
        }
        if ($dash !== '') {
            out('Not starting the dashboard: ' . $dash);
            exit(1);
        }
        // Held until Hermes exits: shared for a session, exclusive for an update, so an update never
        // rewrites the code a running session or scheduled job is using.
        $hermesLock = HermesInstall::lock($isUpdate);
        if (!$hermesLock) {
            out($isUpdate ? 'Not updating: other Hermes sessions, a dashboard or a scheduled job are running from pikkumies/hermes. Close the sessions, stop a dashboard with `pikkumies run dashboard --stop` (or wait a minute for the job) and run `pikkumies run update` again.'
                : 'Hermes is being updated right now (`pikkumies run update`); start again when it has finished.');
            exit(1);
        }
        // First interactive session: the terms until accepted (ADR-0032), then the one feedback question. The agent's name is never
        // asked: it is Pikkumies until the person renames it in chat or with configure (ADR-0032 amendment 2026-10-19). Only on
        // a terminal: cron-tick, docs-fill and piped one-shot runs are never asked and never blocked.
        if (Launch::isTty() && Launch::isSession($passArgs)) {
            try {
                $firstConfig = Config::load();
                if (empty($firstConfig['terms']['accepted'])) {
                    promptWrite(Launch::settingsNote($firstConfig));
                    if (!Launch::askTerms('promptRead', 'promptWrite')) {
                        out('Not starting: the terms of service and privacy policy have to be accepted first. Run `pikkumies` again when you are ready.');
                        exit(1);
                    }
                    Config::acceptTerms();
                    // What the settings review warns about, and where to change things; no session is started for it (ADR-0052).
                    require_once dirname(__DIR__) . '/tools/system/pikkumies-configure/ConfigureSettings.php';
                    promptWrite(Launch::setupHint(ConfigureSettings::review(Config::load(), Config::localDir() . '/hermes/state.db')));
                }
                // Asked once ever: may Pikkumies now and then ask about feedback? Enter means no (ADR-0056 amendment 2026-10-19).
                require_once dirname(__DIR__) . '/tools/system/feedback/FeedbackAsk.php';
                if (FeedbackAsk::offerOnce(Config::load(), 'promptRead', 'promptWrite') === true) {
                    Config::set('feedback.ask', true);
                    out('Feedback questions are on. Turn them off any time with the pikkumies-configure skill.');
                }
            } catch (Exception $x) {
                out('not starting: ' . $x->getMessage());
                exit(1);
            }
        }
        // Regenerate first, so a key or config set after install reaches Hermes. Never start Hermes
        // on a config that could not be written: it would run without the safety hooks. Safe to run
        // from any number of instances at once: Generate::run takes a lock, every file it and
        // HermesConfig::write touch is written through a temp file + rename (ADR-0022).
        try {
            generate(profile());
        } catch (Exception $x) {
            out('not starting: ' . $x->getMessage());
            exit(1);
        }
        foreach (HermesConfig::env() as $envName => $envValue) { // home, managed settings; no HERMES_RUNTIME_DIR (ADR-0033, ADR-0062)
            putenv($envValue === null ? $envName : "$envName=$envValue");
        }
        putenv('PIKKUMIES_DEPTH=' . NestedAgent::childDepth()); // what the agent starts sees it was started by one (ADR-0020)
        if ($isUpdate) {
            passthru(implode(' ', array_map('escapeshellarg', $updateArgv)), $code);
            // The same checks every start makes, right away, so a broken update is reported here.
            $problems = HermesInstall::verify();
            if ($problems) {
                out('Hermes was updated, but Pikkumies will not start it: ' . implode('; ', $problems) . '. Run `pikkumies doctor`; report this to Pikkumies.');
                exit(1);
            }
            HermesInstall::markVerified(HermesInstall::head());
            exit($code);
        }
        // A checkout that moved since it was last checked (/update in a session, a hand edit) is checked first.
        $problems = HermesInstall::checkBeforeStart();
        if ($problems) {
            out('not starting: pikkumies/hermes changed and fails the Pikkumies checks: ' . implode('; ', $problems) . '. Run `pikkumies doctor`.');
            exit(1);
        }
        // The credits line once, before Hermes starts (ADR-0040): a library call, silent when credits cannot be read.
        if (Launch::isTty() && Launch::isSession($passArgs)) {
            require_once dirname(__DIR__) . '/tools/system/credits/CreditsLine.php';
            $creditsUtf8 = CreditsFormat::utf8Locale();
            $creditsProv = Provider::resolve(Config::load());
            if (($runModel = RunFlags::model($passArgs)) !== '') {
                $creditsProv['model'] = $runModel; // -m for this session: the token floor of the model actually used (ADR-0052)
            }
            $creditsBanner = CreditsLine::text($creditsProv, CreditsLine::stateDir(), $creditsUtf8 ? 'utf8' : 'ascii');
            if ($creditsBanner !== '') {
                out($creditsBanner);
            }
            // The memories once, and the tmux status line counts this pane from zero again (ADR-0061).
            require_once dirname(__DIR__) . '/tools/memory/pikkumies/MemoryMetrics.php';
            list($memTotal, $memToday) = SessionCounters::memories(MemoryMetrics::memoryFiles(), gmdate('Ymd'));
            out(SessionCounters::render($memTotal, $memToday, null, $creditsUtf8, ['CreditsFormat', 'short']));
            SessionCounters::reset(Config::localDir(), (string) getenv('TMUX_PANE'));
        }
        // A seeded prompt answered-and-exited (not a TTY on stdin or stdout, Hermes' own behaviour,
        // ADR-0022): pre_verify may never fire for this turn (it only fires after a file edit), so
        // the halt guard judges it itself once Hermes exits (ADR-0047). Interactive runs skip this
        // entirely and keep today's plain passthru.
        if (isset($passArgs[0]) && $passArgs[0] === 'chat' && (!Launch::isTty(STDIN) || !Launch::isTty(STDOUT)) && empty(Config::load()['halt']['disabled'])) {
            exit(HaltRun::run(hermesBin(), $passArgs));
        }
        $args = array_map('escapeshellarg', $passArgs);
        // @: PHP's own warning would print the whole command, the prompt included. -1 means sh itself could not start.
        @passthru(escapeshellarg(hermesBin()) . ' ' . implode(' ', $args), $code);
        if ($code === -1) {
            fwrite(STDERR, HaltRun::START_FAILED);
            exit(1);
        }
        exit($code);

    case 'cron-tick': // internal: the crontab line Update::scheduleCronTick installs, once a minute
        $lockPath = Config::localDir() . '/cron.lock';
        @mkdir(Config::localDir(), 0700, true);
        $lock = @fopen($lockPath, 'c');
        if (!$lock || !flock($lock, LOCK_EX | LOCK_NB)) {
            exit(0); // a previous tick is still running; silent, there is another one in a minute
        }
        if (hermesBin() === '') {
            exit(0); // Hermes not installed yet; `run`/`doctor` already say so, no need to repeat every minute
        }
        if (!CronTick::hasJobs(HermesConfig::home())) {
            exit(0); // no scheduled job: no Python process this minute
        }
        $hermesLock = HermesInstall::lock(false);
        if (!$hermesLock) {
            exit(0); // Hermes is being updated; the next minute's tick runs the due jobs
        }
        $tickProfile = profile();
        $tickArgv = CronTick::argv(hermesBin(), !empty($tickProfile['root']['available']));
        if (!$tickArgv) {
            CronTick::logRefusalOnce(Config::localDir() . '/update.log');
            exit(0);
        }
        foreach (HermesConfig::env() as $envName => $envValue) { // as in run (ADR-0062)
            putenv($envValue === null ? $envName : "$envName=$envValue");
        }
        putenv('PIKKUMIES_DEPTH=' . NestedAgent::childDepth()); // scheduled agents count as agents, as in run (ADR-0020)
        $problems = HermesInstall::checkBeforeStart(CronTick::setprivPresent() ? ['setpriv', '--no-new-privs'] : []);
        if ($problems) {
            CronTick::logIfChanged(Config::localDir() . '/update.log', Config::localDir() . '/cron-tick.state', 3, 'not run: pikkumies/hermes changed and fails the Pikkumies checks: ' . implode('; ', $problems));
            exit(0);
        }
        $tickOut = [];
        exec(implode(' ', array_map('escapeshellarg', CronTick::lowPriority($tickArgv))) . ' 2>&1', $tickOut, $tickCode);
        CronTick::logIfChanged(Config::localDir() . '/update.log', Config::localDir() . '/cron-tick.state', $tickCode, implode("\n", $tickOut));
        exit($tickCode);

    case 'tmux': // window pmN of the tmux session "pikkumies", running pikkumies (ADR-0032)
        $n = isset($passArgs[0]) ? $passArgs[0] : '1';
        if (!preg_match('/^[1-9]$/', $n)) {
            out('usage: pikkumies tmux [1-9]');
            exit(2);
        }
        exec('command -v tmux 2>/dev/null', $tmuxPath, $tmuxCode);
        if ($tmuxCode !== 0) {
            out('tmux is not installed on this machine. Plain `pikkumies` starts a session without it; install tmux (or ask your provider) to use `pikkumies tmux`.');
            exit(1);
        }
        $windows = null;
        exec('tmux list-windows -t ' . escapeshellarg('=' . Launch::TMUX_SESSION) . ' -F ' . escapeshellarg('#W') . ' 2>/dev/null', $windowList, $listCode);
        if ($listCode === 0) {
            $windows = $windowList;
        }
        $insideTmux = (string) getenv('TMUX') !== '';
        // The session's status line shows the credits line, refreshed every minute (ADR-0040).
        // NO_COLOR at this start reaches the credits line tmux runs, and keeps the status colours off (ADR-0061).
        $noColor = StatusTheme::noColor();
        $creditsCmd = ($noColor ? 'NO_COLOR=1 ' : '') . escapeshellarg(PHP_BINARY) . ' ' . escapeshellarg(dirname(__DIR__) . '/tools/system/credits/credits.php') . ' line --tmux';
        // Before it: the memories and the active pane's counters (ADR-0061).
        $self = escapeshellarg(PHP_BINARY) . ' ' . escapeshellarg(__FILE__);
        $plan = Launch::tmuxPlan($n, $windows, $insideTmux, $self, $creditsCmd, $self . ' status-line', !$noColor);
        $attach = array_pop($plan);
        foreach ($plan as $step) {
            exec(implode(' ', array_map('escapeshellarg', $step)) . ' 2>&1', $stepOut, $stepCode);
            if ($stepCode !== 0) {
                out('tmux failed: ' . implode(' ', $stepOut));
                exit(1);
            }
        }
        passthru(implode(' ', array_map('escapeshellarg', $attach)), $code);
        exit($code);

    case 'status-line': // internal: the tmux status segment `pikkumies tmux` sets (ADR-0061); prints nothing on any failure, as the credits line
        try {
            require_once dirname(__DIR__) . '/tools/system/credits/CreditsFormat.php';
            require_once dirname(__DIR__) . '/tools/memory/pikkumies/MemoryMetrics.php';
            $pane = '';
            foreach ($passArgs as $a) {
                $pane = strncmp($a, '--pane=', 7) === 0 ? substr($a, 7) : $pane;
            }
            list($memTotal, $memToday) = SessionCounters::memories(MemoryMetrics::memoryFiles(), gmdate('Ymd'));
            out(SessionCounters::render($memTotal, $memToday, SessionCounters::read(Config::localDir(), $pane), CreditsFormat::utf8Locale(), ['CreditsFormat', 'short']));
        } catch (\Throwable $x) {
        }
        exit(0);

    case 'help':
    default:
        out('usage: pikkumies [install | update | detect | doctor | generate]');
        out('       pikkumies [run [hermes args...]]           plain interactive session');
        out('       pikkumies run update                       update Hermes with its own updater (separate from `pikkumies update`)');
        out('       pikkumies <free text>                      start a session with that as the first prompt');
        out('       pikkumies -- <free text>                   force a prompt even if it starts with a subcommand name');
        out('       pikkumies -m <model> [free text]           a session with that model (also --model, and --reasoning <level>)');
        out('       pikkumies --prompt-file FILE|-             the first prompt from a file, or from stdin with - (for long prompts)');
        out('       pikkumies --resume <session id> [text]     continue that session');
        out('       pikkumies configure                        review your settings and change them with the agent');
        out('       pikkumies configure undo                   set the last settings change back (asks y/N only for a change you would be asked about)');
        out('       pikkumies tmux [1-9]                       a session in window pmN of the tmux session "pikkumies"');
        out('       pikkumies install [--name=<name>] [--accept-terms] [--telemetry=on|off] [--perf-logging=on|off] [--retention-days=N] [--channel=release|git/<branch>]');
}
